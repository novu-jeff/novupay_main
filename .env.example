APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Novupay Starita DB
STARITA_DB_HOST=127.0.0.1
STARITA_DB_PORT=3306
STARITA_DB_DATABASE=novupay_starita
STARITA_DB_USERNAME=root
STARITA_DB_PASSWORD=

# Sta Rita app DB (source of payor/email/contact enrichment)
STARITA_APP_DB_HOST=127.0.0.1
STARITA_APP_DB_PORT=3306
STARITA_APP_DB_DATABASE=sta_rita_db_test
STARITA_APP_DB_USERNAME=root
STARITA_APP_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Kaelco: URL to notify when a payment is completed (optional; has default)
# KAELCO_WEBHOOK_URL=https://www.kaelco.org/Upgrade/dist/API/novupay_webhook.php

# Hosted Checkout API — values from Link Store at https://novu-pay.com (never commit real secrets)
NOVUPAY_API_KEY=
NOVUPAY_CLIENT_ID=
NOVUPAY_CLIENT_SECRET=
NOVUPAY_API_BASE=https://api.novu-pay.com
# Optional: force DNS for API host to an internal IP (LAN hairpin / DNAT target)
NOVUPAY_API_RESOLVE_IP=
NOVUPAY_HOSTED_BASE=https://novu-pay.com
NOVUPAY_NOTIFICATION_URL=https://portal.staritawaterdistrictpamp.gov.ph/webhooks/novupay
NOVUPAY_REDIRECT_URL=https://portal.staritawaterdistrictpamp.gov.ph/payments/novupay/return

# Past-due SOA QR (Starita payment-request + generic /api/payment-request):
# true  = apply penalty / amount_after_due and continue to HitPay
# false = invalidate QR → /payment-expired/{reference_no}
DUE_DATE_QR_PENALTY=true

# Legacy alias (used only when DUE_DATE_QR_PENALTY is unset): void | penalty
# NOVUPAY_OVERDUE_QR_MODE=void
# Optional redirect override (use {reference_no} placeholder)
# NOVUPAY_OVERDUE_REDIRECT_URL=

# Other Services nav + NovuStream/NovuSurge white papers (false = hidden, URLs redirect home)
NOVUPAY_OTHER_SERVICES_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
